# Zero-configuration local development storage.
DATABASE_PATH=.data/followup.db

# PostgreSQL takes precedence when configured. Keep credentials outside Git.
# DATABASE_URL=postgresql://user:password@localhost:5432/career_followup

# Rate limiting is enabled unless explicitly set to false for emergency rollback.
AUTH_RATE_LIMIT_ENABLED=true

# Enable only behind a proxy that removes client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false
