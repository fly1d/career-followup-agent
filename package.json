{
  "name": "career-followup-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "allowScripts": {},
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
